<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/color_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnRegresar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:tint="@color/color_text"
            android:contentDescription="@string/autorizar_con_motivo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/autorizar_con_motivo"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/color_text" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvResumenDiferencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_row_warn"
            android:padding="12dp"
            android:textSize="13sp"
            android:textColor="@color/color_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/motivo_label"
            android:textSize="13sp"
            android:textColor="@color/color_text_muted" />

        <EditText
            android:id="@+id/etMotivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/shape_input_field"
            android:gravity="top"
            android:hint="@string/motivo_hint"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:textSize="14sp"
            android:textColor="@color/color_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/autorizado_por_label"
            android:textSize="13sp"
            android:textColor="@color/color_text_muted" />

        <EditText
            android:id="@+id/etAutorizadoPor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/shape_input_field"
            android:hint="@string/autorizado_por_hint"
            android:inputType="textPersonName"
            android:singleLine="true"
            android:textSize="14sp"
            android:textColor="@color/color_text" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancelar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/shape_button_outline"
                android:text="@string/cancelar"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/color_accent" />

            <Button
                android:id="@+id/btnAutorizar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/shape_button_filled"
                android:text="@string/autorizar_boton"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/color_on_accent" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
