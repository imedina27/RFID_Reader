<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/color_background">

    <!-- barra superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/logo_quantum"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="@string/app_name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/color_text" />

        <ImageButton
            android:id="@+id/btnAjustes"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings"
            android:tint="@color/color_text"
            android:contentDescription="@string/ajustes" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_border" />

    <!-- contenido -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- tarjeta de conexión -->
        <LinearLayout
            android:id="@+id/tarjetaConexion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/shape_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:padding="14dp">

            <ImageView
                android:id="@+id/imgBadgeLectora"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/shape_oval"
                android:padding="11dp"
                android:src="@drawable/ic_signal"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNombreLectora"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sin_conectar"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_text"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lectora_cs108"
                    android:textSize="12sp"
                    android:textColor="@color/color_text_muted" />
            </LinearLayout>

            <TextView
                android:id="@+id/chipConexion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_chip"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="@string/desconectado"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- estado del gatillo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <FrameLayout
                android:id="@+id/circuloEstado"
                android:layout_width="136dp"
                android:layout_height="136dp"
                android:background="@drawable/shape_circle_idle">

                <ImageView
                    android:id="@+id/imgCirculoIcono"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_target"
                    android:tint="@color/color_text_muted"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvEstadoTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/conectate_primero"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/color_text"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvEstadoSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/toca_para_conectar"
                android:textSize="13sp"
                android:textColor="@color/color_text_muted"
                android:gravity="center" />
        </LinearLayout>

        <!-- etiquetas leídas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/etiquetas_leidas"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_text" />

                <TextView
                    android:id="@+id/chipConteo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_chip"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="0"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_muted" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lvLecturas"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:clipToPadding="false" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
